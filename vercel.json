{
  "crons": [
    {
      "path": "/api/cron/reconcile-orders",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/__route_probe/foo/bar",
      "destination": "/api/_routingProbe?__dispatch=foo/bar"
    },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
