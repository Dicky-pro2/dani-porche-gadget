{
  "crons": [
    {
      "path": "/api/cron/reconcile-orders",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/_admin?__dispatch=:path*"
    },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
