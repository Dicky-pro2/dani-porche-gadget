# Server-only CocoBase project API key. Never add a VITE_ prefix.
COCOBASE_API_KEY=
# CocoBase collection containing product documents (defaults to "products").
COCOBASE_PRODUCTS_COLLECTION=products
# Public canonical HTTPS site origin. Set to the matching deployment origin.
VITE_SITE_URL=https://dani-porche-gadget.vercel.app
